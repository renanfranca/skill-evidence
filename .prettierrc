# Prettier configuration adapted from codex-skills/website.
printWidth: 140
singleQuote: true
tabWidth: 2
useTabs: false
endOfLine: 'lf'
experimentalOperatorPosition: start

plugins:
  - prettier-plugin-organize-imports
  - prettier-plugin-packagejson

arrowParens: avoid
bracketSameLine: false

overrides:
  - files: ['*.jsonc']
    options:
      trailingComma: none
