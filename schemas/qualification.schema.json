{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-evidence.local/schemas/qualification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "probes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "probes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "input"],
        "properties": {
          "purpose": {
            "enum": ["known-valid", "known-invalid", "alternative-valid", "unsupported-fluency"]
          },
          "input": { "type": "object" }
        }
      },
      "allOf": [
        { "contains": { "type": "object", "properties": { "purpose": { "const": "known-valid" } } } },
        { "contains": { "type": "object", "properties": { "purpose": { "const": "known-invalid" } } } },
        { "contains": { "type": "object", "properties": { "purpose": { "const": "alternative-valid" } } } },
        { "contains": { "type": "object", "properties": { "purpose": { "const": "unsupported-fluency" } } } }
      ]
    }
  }
}
