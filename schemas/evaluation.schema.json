{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-evidence.local/schemas/evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "decision", "population", "exclusions", "claims", "thresholds", "runtime", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "decision": { "type": "string", "minLength": 1 },
    "population": { "type": "string", "minLength": 1 },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "label": { "type": "string", "minLength": 1 } }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredPassingCases", "maxCriticalViolations", "requireCalibratedJudge"],
      "properties": {
        "requiredPassingCases": { "type": "integer", "minimum": 1 },
        "maxCriticalViolations": { "const": 0 },
        "requireCalibratedJudge": { "const": true }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillSource", "skillCommit", "theoryCommit", "timeoutMs"],
      "properties": {
        "skillSource": { "type": "string", "minLength": 1 },
        "skillCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "theoryCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
      }
    },
    "cases": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } }
  }
}
