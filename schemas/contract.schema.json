{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-evidence.local/schemas/contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "preconditions",
    "requiredEffects",
    "prohibitedEffects",
    "temporalConstraints",
    "severity",
    "evidence",
    "claims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "preconditions": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "requiredEffects": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "prohibitedEffects": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "temporalConstraints": { "type": "array", "items": { "$ref": "#/$defs/temporal" } },
    "severity": { "enum": ["critical", "major", "minor"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["diff", "command", "trajectory", "message", "path-audit", "skill-fingerprint"] }
    },
    "claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["command-exit", "file-changed", "file-unchanged", "no-changes", "message-match", "no-write-outside", "skill-unchanged"]
        },
        "path": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exitCode": { "type": "integer" },
        "pattern": { "type": "string" }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": { "before": { "type": "string" }, "after": { "type": "string" } }
    }
  }
}
