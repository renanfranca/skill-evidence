{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-evidence.local/schemas/evaluation-blueprint.schema-3.json",
  "title": "EvaluationBlueprint schema-3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blueprintId",
    "snapshotFingerprint",
    "lifecycle",
    "authorProvenance",
    "skill",
    "decisionContext",
    "population",
    "claimRequirements",
    "claims",
    "exclusions",
    "contracts",
    "activationRegions",
    "usageFamilies",
    "stressFamilies",
    "contrasts",
    "evidencePlan",
    "oracleQualificationPlan",
    "samplingPlan",
    "analysisPlan",
    "policies",
    "stoppingConditions",
    "unresolvedRequirements",
    "untestedRisks"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "blueprintId": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
    "snapshotFingerprint": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
    "lifecycle": { "$ref": "evaluation-blueprint.schema.json#/properties/lifecycle" },
    "authorProvenance": { "$ref": "#/$defs/authorProvenance" },
    "skill": { "$ref": "evaluation-blueprint.schema.json#/properties/skill" },
    "decisionContext": { "$ref": "authoring-context.schema.json#/properties/decisionContext" },
    "population": { "$ref": "authoring-context.schema.json#/properties/population" },
    "claimRequirements": { "$ref": "authoring-context.schema.json#/properties/claimRequirements" },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/composedClaim" } },
    "exclusions": { "$ref": "evaluation-blueprint.schema.json#/properties/exclusions" },
    "contracts": { "$ref": "evaluation-blueprint.schema.json#/properties/contracts" },
    "activationRegions": { "$ref": "evaluation-blueprint.schema.json#/properties/activationRegions" },
    "usageFamilies": { "$ref": "evaluation-blueprint.schema.json#/properties/usageFamilies" },
    "stressFamilies": { "$ref": "evaluation-blueprint.schema.json#/properties/stressFamilies" },
    "contrasts": { "$ref": "evaluation-blueprint.schema.json#/properties/contrasts" },
    "evidencePlan": { "type": "array", "items": { "$ref": "#/$defs/composedEvidenceRequirement" } },
    "oracleQualificationPlan": { "$ref": "evaluation-blueprint.schema.json#/properties/oracleQualificationPlan" },
    "samplingPlan": { "$ref": "evaluation-blueprint.schema.json#/properties/samplingPlan" },
    "analysisPlan": { "$ref": "evaluation-blueprint.schema.json#/properties/analysisPlan" },
    "policies": { "$ref": "evaluation-blueprint.schema.json#/properties/policies" },
    "stoppingConditions": { "$ref": "evaluation-blueprint.schema.json#/properties/stoppingConditions" },
    "unresolvedRequirements": { "type": "array", "items": { "$ref": "#/$defs/composedRequirement" } },
    "untestedRisks": { "$ref": "evaluation-blueprint.schema.json#/properties/untestedRisks" }
  },
  "$defs": {
    "candidateId": {
      "allOf": [
        { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        { "not": { "pattern": "^system:authoring-context:" } }
      ]
    },
    "candidateReference": {
      "allOf": [
        { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        { "not": { "pattern": "^system:authoring-context:" } }
      ]
    },
    "candidateReferenceArray": { "type": "array", "items": { "$ref": "#/$defs/candidateReference" } },
    "claimRequirementId": { "$ref": "authoring-context.schema.json#/$defs/claimRequirementId" },
    "candidateClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "statement", "conditions", "requiredEvidence", "limitations"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "claimRequirementId": { "$ref": "#/$defs/claimRequirementId" },
        "type": { "$ref": "authoring-context.schema.json#/$defs/claimType" },
        "statement": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "conditions": { "$ref": "evaluation-blueprint.schema.json#/$defs/stringArray" },
        "requiredEvidence": { "$ref": "#/$defs/candidateReferenceArray" },
        "limitations": { "$ref": "evaluation-blueprint.schema.json#/$defs/stringArray" }
      }
    },
    "composedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statement",
        "conditions",
        "requiredEvidence",
        "limitations",
        "mandatory",
        "decisionCritical",
        "populationScopeIds",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "claimRequirementId": { "$ref": "#/$defs/claimRequirementId" },
        "type": { "$ref": "authoring-context.schema.json#/$defs/claimType" },
        "statement": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "conditions": { "$ref": "evaluation-blueprint.schema.json#/$defs/stringArray" },
        "requiredEvidence": { "$ref": "#/$defs/candidateReferenceArray" },
        "limitations": { "$ref": "evaluation-blueprint.schema.json#/$defs/stringArray" },
        "mandatory": { "type": "boolean" },
        "decisionCritical": { "type": "boolean" },
        "populationScopeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "authoring-context.schema.json#/$defs/populationScopeId" }
        },
        "status": { "const": "NOT_EVALUATED" }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "purpose": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidenceKind", "observable", "evidenceSource", "capability"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "evidenceKind": { "const": "DIRECT" },
        "observable": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "evidenceSource": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "capability": { "$ref": "#/$defs/capabilityRequirement" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observationIds", "evidenceKind", "procedure", "assessmentSource", "capability"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "observationIds": { "$ref": "#/$defs/candidateReferenceArray" },
        "evidenceKind": { "enum": ["STRUCTURED_DETERMINISTIC_INFERENCE", "SEMANTIC", "JUDGMENT"] },
        "procedure": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "assessmentSource": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "capability": { "$ref": "#/$defs/capabilityRequirement" }
      }
    },
    "evidencePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observations", "assessments"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
        "assessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessment" } }
      }
    },
    "observabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "paths"],
      "properties": {
        "operator": { "const": "ANY_PATH" },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencePath" } }
      }
    },
    "candidateEvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimIds", "contractIds", "property", "mandatory", "critical", "observabilityRequirement"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "claimIds": { "$ref": "#/$defs/candidateReferenceArray" },
        "contractIds": { "$ref": "#/$defs/candidateReferenceArray" },
        "property": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "mandatory": { "type": "boolean" },
        "critical": { "type": "boolean" },
        "observabilityRequirement": { "$ref": "#/$defs/observabilityRequirement" }
      }
    },
    "composedEvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claimIds",
        "contractIds",
        "property",
        "mandatory",
        "critical",
        "observabilityRequirement",
        "missingEvidenceSemantics"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "claimIds": { "$ref": "#/$defs/candidateReferenceArray" },
        "contractIds": { "$ref": "#/$defs/candidateReferenceArray" },
        "property": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "mandatory": { "type": "boolean" },
        "critical": { "type": "boolean" },
        "observabilityRequirement": { "$ref": "#/$defs/observabilityRequirement" },
        "missingEvidenceSemantics": { "const": "INCONCLUSIVE_WHEN_ELIGIBLE_PATH_EVIDENCE_IS_MISSING" }
      }
    },
    "composedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "reason", "status", "blocking", "evidenceNeeded", "source", "affectedClaimIds", "origin"],
      "properties": {
        "id": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "field": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "reason": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "status": { "enum": ["UNKNOWN", "UNSUPPORTED", "INSUFFICIENT_INFORMATION", "UNTESTABLE_FROM_AVAILABLE_ENVIRONMENT"] },
        "blocking": { "type": "boolean" },
        "evidenceNeeded": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "source": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" },
        "affectedClaimIds": { "$ref": "#/$defs/candidateReferenceArray" },
        "affectedClaimRequirementId": { "$ref": "#/$defs/claimRequirementId" },
        "dependency": { "$ref": "authoring-context.schema.json#/$defs/dependency" },
        "origin": { "enum": ["AUTHOR", "SYSTEM_AUTHORING_CONTEXT"] }
      }
    },
    "authorProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "conditionFingerprint",
        "authorInstrumentFingerprint",
        "authoringContextFingerprint",
        "packetFingerprint",
        "packetEvidenceKind",
        "requestedModel",
        "observedModel",
        "reasoningEffort",
        "instructionDigest",
        "theoryDigest",
        "schemaDigest",
        "candidateSchemaDigest",
        "authoringContextSchemaDigest",
        "compositionPolicyDigest",
        "protocolDigest",
        "campaignId"
      ],
      "properties": {
        "status": { "const": "NOT_QUALIFIED" },
        "conditionFingerprint": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "authorInstrumentFingerprint": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "authoringContextFingerprint": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "packetFingerprint": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "packetEvidenceKind": { "const": "AUTHOR_INVOKER_REQUEST_PROMPT" },
        "requestedModel": { "enum": ["gpt-5.6-terra", "gpt-5.6-luna"] },
        "observedModel": { "type": ["string", "null"] },
        "reasoningEffort": { "enum": ["xhigh", "max"] },
        "instructionDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "theoryDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "schemaDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "candidateSchemaDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "authoringContextSchemaDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "compositionPolicyDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "protocolDigest": { "$ref": "evaluation-blueprint.schema.json#/$defs/digest" },
        "campaignId": { "$ref": "evaluation-blueprint.schema.json#/$defs/nonEmptyString" }
      },
      "oneOf": [
        { "properties": { "requestedModel": { "const": "gpt-5.6-terra" }, "reasoningEffort": { "const": "xhigh" } } },
        { "properties": { "requestedModel": { "const": "gpt-5.6-luna" }, "reasoningEffort": { "const": "max" } } }
      ]
    }
  }
}
