          "expected": "PASS",
          "input": { "idSource": "observable", "observable": { "effect": "preserved", "severity": "critical" } }
        },
        {
          "id": "label-derived-identifier",
          "expected": "FAIL",
          "input": {
            "idSource": "expected-status",
            "label": "known-valid",
            "observable": { "effect": "preserved", "severity": "critical" }
          }
        }
      ]
    },
    {
      "id": "R5",
      "owner": ["SKILL_EVIDENCE_PREFLIGHT", "SKILL_EVIDENCE_NORMALIZATION"],
      "observations": [
