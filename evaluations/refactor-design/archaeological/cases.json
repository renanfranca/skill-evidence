{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "R1",
      "owner": "PROMPTFOO_ASSERTION",
      "observations": [
        {
          "id": "absolute-executable-path",
          "expected": "PASS",
          "input": { "outsideWorkspace": true, "path": "/opt/codex/bin/codex", "role": "executable" }
        },
        {
          "id": "external-write-target",
          "expected": "FAIL",
          "input": { "outsideWorkspace": true, "path": "/tmp/persisted-result.json", "role": "write-target" }
        }
      ]
    },
    {
