      "owner": ["SKILL_EVIDENCE_PREFLIGHT", "SKILL_EVIDENCE_NORMALIZATION"],
      "observations": [
        {
          "id": "known-unavailable-critical-evidence",
          "expected": "BLOCKED",
          "input": { "capabilityEligible": false, "eventRecognition": "NOT_RUN" }
        },
        {
          "id": "late-relevant-unknown-event",
          "expected": "INCONCLUSIVE",
          "input": { "capabilityEligible": true, "eventRecognition": "UNKNOWN_RELEVANT" }
        },
        {
          "id": "missing-disposition-metadata",
          "expected": "BLOCKED",
          "input": { "capabilityEligible": true, "eventRecognition": "UNMAPPED" }
        }
      ]
    },
    {
      "id": "R3",
      "owner": "PROMPTFOO_GRADER",
      "observations": [
        {
          "id": "equivalent-no-refactor-conclusion",
          "expected": "PASS",
          "input": { "message": "No refactor was justified." }
        },
        {
          "id": "unsupported-refactor-conclusion",
          "expected": "FAIL",
          "input": { "message": "A refactor is required, but no changes were made." }
        }
      ]
    },
    {
      "id": "R4",
      "owner": "SKILL_EVIDENCE_INPUT_PROJECTION",
      "observations": [
        {
