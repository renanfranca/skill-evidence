        {
          "id": "late-missing-required-evidence",
          "expected": "INCONCLUSIVE",
          "input": { "capabilityEligible": true, "evidenceState": "MISSING_LATE" }
        }
      ]
    },
    {
      "id": "R6",
      "owner": "PROMPTFOO_SCORING",
      "observations": [
        {
          "id": "critical-violation-overrides-favorable-judge",
